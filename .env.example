# Образец файла .env (Нургуль, доп. функция: настоящая почта).
# Скопируйте этот файл в .env рядом с manage.py и впишите свои данные.
# Сам .env в GitHub не попадает — он в .gitignore.
#
# GMAIL_ADDRESS — почта Gmail, с которой сайт будет отправлять письма
# GMAIL_APP_PASSWORD — пароль приложения из 16 букв (не обычный пароль от почты!)
# Как получить: myaccount.google.com → Безопасность → Двухэтапная аутентификация
# (включить) → Пароли приложений → создать → скопировать 16 букв без пробелов.
GMAIL_ADDRESS=example@gmail.com
GMAIL_APP_PASSWORD=abcdabcdabcdabcd
